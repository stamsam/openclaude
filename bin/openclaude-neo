#!/usr/bin/env node

/**
 * OpenClaude Neo - dashboard-first launcher.
 *
 * Defaults to `openclaude agents` while reusing the normal OpenClaude bundle.
 * Utility commands still pass through:
 *   openclaude-neo --version
 *   openclaude-neo attach <id>
 *   openclaude-neo logs <id>
 */

import { existsSync } from 'fs'
import { spawnSync } from 'child_process'
import { join, dirname } from 'path'
import { fileURLToPath, pathToFileURL } from 'url'
import { rewriteOpenClaudeNeoArgv } from './openclaude-neo-args.mjs'

const __dirname = dirname(fileURLToPath(import.meta.url))
const projectRoot = join(__dirname, '..')
const distPath = join(projectRoot, 'dist', 'cli.mjs')

function run(command, args) {
  const result = spawnSync(command, args, {
    cwd: projectRoot,
    stdio: 'inherit',
  })
  if (result.error) {
    console.error(`\nopenclaude-neo: failed to run ${command}: ${result.error.message}`)
    process.exit(1)
  }
  if (result.status !== 0) {
    process.exit(result.status ?? 1)
  }
}

if (!existsSync(distPath)) {
  console.error('openclaude-neo: dist/cli.mjs not found; building linked checkout...\n')
  run('bun', ['install'])
  run('bun', ['run', 'build'])
  if (!existsSync(distPath)) {
    console.error('\nopenclaude-neo: build finished but dist/cli.mjs is still missing.')
    process.exit(1)
  }
}

process.argv = rewriteOpenClaudeNeoArgv(process.argv)

await import(pathToFileURL(distPath).href)
